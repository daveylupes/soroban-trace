{
  "name": "soroban-trace",
  "version": "0.1.0",
  "description": "Developer tool for tracing and visualizing Soroban smart contract execution on the Stellar network",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "soroban-trace": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "QUICKSTART.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepare": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daveylupes/soroban-trace.git"
  },
  "bugs": {
    "url": "https://github.com/daveylupes/soroban-trace/issues"
  },
  "homepage": "https://github.com/daveylupes/soroban-trace#readme",
  "keywords": [
    "stellar",
    "soroban",
    "smart-contracts",
    "debugging",
    "tracing",
    "blockchain",
    "developer-tools",
    "stellar-network"
  ],
  "author": "David M.",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^14.2.0",
    "commander": "^12.0.0",
    "chalk": "^4.1.2",
    "axios": "^1.6.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}

